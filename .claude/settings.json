{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run validate)",
      "Bash(git pull:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-on-edit.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
